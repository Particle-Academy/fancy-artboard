{
  "name": "@particle-academy/fancy-artboard",
  "version": "0.3.0",
  "description": "Figma-style design canvas for Human+ UX — a pan/zoom ArtBoard of ArtPieces (image, HTML, or JSX). Agent-driveable and renderable inside a fancy-screens Screen.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Particle-Academy/fancy-artboard.git"
  },
  "homepage": "https://github.com/Particle-Academy/fancy-artboard#readme",
  "bugs": "https://github.com/Particle-Academy/fancy-artboard/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./screens": {
      "import": {
        "types": "./dist/screens.d.ts",
        "default": "./dist/screens.js"
      },
      "require": {
        "types": "./dist/screens.d.cts",
        "default": "./dist/screens.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit && eslint .",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run test && npm run lint && tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "react",
    "canvas",
    "design",
    "artboard",
    "figma",
    "fancy",
    "particle-academy"
  ],
  "peerDependencies": {
    "@particle-academy/fancy-screens": ">=0.4 <2.0",
    "@particle-academy/react-fancy": ">=3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@particle-academy/fancy-screens": {
      "optional": true
    }
  },
  "devDependencies": {
    "@particle-academy/fancy-screens": "^0.5.0",
    "@particle-academy/react-fancy": "^4.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22"
  }
}
